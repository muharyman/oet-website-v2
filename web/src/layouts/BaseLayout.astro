---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'
import { getAbsoluteLocaleUrl } from 'astro:i18n'
import '../styles/global.css'
import Preloader from '../components/layout/Preloader.astro'
import SiteFooter from '../components/layout/SiteFooter.astro'
import SiteHeader from '../components/layout/SiteHeader.astro'
import { loadFooter } from '../data/footer'
import { loadNavigation, type HeaderTheme } from '../data/navigation'
import { loadSiteSettings } from '../data/site'
import { defaultLocale, locales, type Locale } from '../i18n/config'
import { t } from '../i18n/ui'
import { indexingEnabled } from '../lib/indexing'

interface Share {
  image: ImageMetadata | null
  type: 'website' | 'article'
}

interface Props {
  title: string
  description: string
  share: Share
  headerTheme: HeaderTheme
  initialHeaderTheme: HeaderTheme
}

const { title, description, share, headerTheme, initialHeaderTheme } = Astro.props
const locale = locales.find((code) => code === Astro.currentLocale)
if (!locale) throw new Error(`Unsupported locale: ${Astro.currentLocale}`)
const [navigation, footer, settings] = await Promise.all([
  loadNavigation(locale),
  loadFooter(locale),
  loadSiteSettings(locale),
])

const indexing = indexingEnabled()

const ogLocales: Record<Locale, string> = { en: 'en_US' }
const withoutTrailingSlash = (url: string) => {
  const parsed = new URL(url)
  if (parsed.pathname !== '/') parsed.pathname = parsed.pathname.replace(/\/$/, '')
  return parsed.href
}
const canonical = withoutTrailingSlash(new URL(Astro.url.pathname, Astro.site).href)
const localePath = Astro.url.pathname.replace(/^\//, '')
const alternates = locales.map((code) => ({
  code,
  href: withoutTrailingSlash(getAbsoluteLocaleUrl(code, localePath)),
}))
const defaultAlternate = alternates.find(({ code }) => code === defaultLocale)
if (!defaultAlternate) throw new Error(`No alternate URL for ${defaultLocale}`)
const tagManagerScript =
  settings.tagManagerId === null
    ? null
    : `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',${JSON.stringify(settings.tagManagerId)});`
const shareImage = await getImage({
  src: share.image === null ? settings.shareImage : share.image,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
})
const shareImageUrl = new URL(shareImage.src, Astro.site).href
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: settings.name,
  url: new URL('/', Astro.site).href,
  sameAs: settings.profiles,
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexing && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
    <meta property="og:type" content={share.type} />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content={String(shareImage.attributes.width)} />
    <meta property="og:image:height" content={String(shareImage.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {tagManagerScript !== null && <script is:inline set:html={tagManagerScript} />}
    <slot name="head" />
  </head>
  <body>
    {settings.tagManagerId !== null && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${settings.tagManagerId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        />
      </noscript>
    )}
    <Preloader />
    <a href="#main" class="skip-link">
      {t(locale, 'nav.skip')}
    </a>
    <SiteHeader
      navigation={navigation}
      theme={headerTheme}
      initialTheme={initialHeaderTheme}
      locale={locale}
      locales={locales}
    />
    <slot />
    <SiteFooter content={footer} locale={locale} />
  </body>
</html>
