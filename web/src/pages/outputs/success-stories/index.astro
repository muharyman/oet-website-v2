---
import ListingHeader from '../../../components/blocks/ListingHeader.astro'
import PageHero from '../../../components/blocks/PageHero.astro'
import TestimonialSlider from '../../../components/blocks/TestimonialSlider.astro'
import ProjectCard from '../../../components/cards/ProjectCard.astro'
import FilterBar from '../../../components/ui/FilterBar.astro'
import FilterTabs from '../../../components/ui/FilterTabs.astro'
import Pagination from '../../../components/ui/Pagination.astro'
import { loadFilters, pagination, sort } from '../../../data/outputs'
import { loadSuccessStories } from '../../../data/projects'
import { routes } from '../../../data/routes'
import { defaultLocale } from '../../../i18n/config'
import { t } from '../../../i18n/ui'
import BaseLayout from '../../../layouts/BaseLayout.astro'

const locale = defaultLocale
const [{ meta, hero, listing, testimonials }, filters] = await Promise.all([
  loadSuccessStories(locale),
  loadFilters(locale, 'projects'),
])
const hrefFor = (page: number) => `${routes.successStories}?page=${page}`
const container = 'max-w-page px-gutter lg:px-gutter-lg mx-auto w-full'
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  headerTheme="dark"
  initialHeaderTheme="light"
>
  <main id="main">
    <PageHero
      layout="listing"
      title={hero.title}
      titleSize="display-2"
      titleSizeMobile="display-5"
      eyebrow={null}
      lead={[]}
      links={hero.links}
      stats={null}
      person={null}
      image={hero.image}
      background="brand-700"
      chipsBottomMobile={62}
      ornament="left-upper"
      headerTheme="light"
    />

    <ListingHeader
      layout="stacked"
      title={listing.title}
      description={listing.description}
      descriptionStyle="body-md-medium"
      tabsWidth="column"
      topSpace={180}
      id={listing.id}
    >
      <FilterTabs
        slot="tabs"
        label={t(locale, 'tabs.projectStatus')}
        layout="compact"
        mobileBreakAfter={null}
        options={listing.tabs}
      />
      <FilterBar
        slot="controls"
        locale={locale}
        filters={filters}
        sort={sort(locale, 'projects')}
      />
      <Pagination
        class="py-5 lg:hidden"
        current={pagination.current}
        total={pagination.total}
        hrefFor={hrefFor}
        locale={locale}
      />
    </ListingHeader>

    <div class={container}>
      <ul class="grid gap-5 border-t border-neutral-100 py-5 lg:grid-cols-3 lg:gap-y-10 lg:border-l lg:pl-5">
        {listing.items.map((project, index) => {
          return (
            <li class:list={[index >= listing.mobilePageSize && 'max-lg:hidden']}>
              <ProjectCard
                title={project.title}
                titleLines={2}
                excerpt={project.excerpt}
                period={project.period}
                href={routes.successStory(project.slug)}
                linkLabel={t(locale, 'card.viewProject')}
                image={project.thumbnail}
                alt={project.alt}
                sizes="(min-width: 1440px) 367px, (min-width: 1024px) calc((100vw - 340px) / 3), calc(100vw - 80px)"
                frame={project.frame}
                mobileFrame="fixed"
                height="fixed"
                partnerTag={project.partnerTag}
                partnerLink={project.partnerLink}
                footer="when-partner"
                class="h-full"
              />
            </li>
          )
        })}
      </ul>
      <div class="flex justify-center border-neutral-100 pt-10 pb-[60px] lg:border-l">
        <Pagination
          class="w-full lg:w-[372px]"
          current={pagination.current}
          total={pagination.total}
          hrefFor={hrefFor}
          locale={locale}
        />
      </div>
      <div class="border-l border-neutral-100 py-[180px]">
        <TestimonialSlider
          variant="wide"
          heading={testimonials.heading}
          subline={testimonials.subline}
          locale={locale}
          items={testimonials.items}
        />
      </div>
    </div>
  </main>
</BaseLayout>
