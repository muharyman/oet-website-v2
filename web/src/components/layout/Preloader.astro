---
import { Image } from 'astro:assets'
import mark from '../../assets/brand/oet-mark-white-preloader.png'
---

<script is:inline>
  if (!sessionStorage.getItem('oet-visited')) {
    sessionStorage.setItem('oet-visited', '1')
    document.documentElement.classList.add('oet-first-visit')
  }
</script>
<div class="oet-preloader" aria-hidden="true">
  <Image src={mark} alt="" width={85} height={38} densities={[1, 2]} fit="fill" loading="lazy" />
</div>

<style is:global>
  .oet-preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: var(--color-brand-500);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .oet-first-visit .oet-preloader {
      display: flex;
      animation: oet-preloader-out 0.6s ease-out 1.5s forwards;
    }
  }

  @keyframes oet-preloader-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
</style>
